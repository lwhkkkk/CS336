# ==========================================
# CS336 Project .gitignore
# ==========================================

# ------------------------------------------
# 1. Datasets & Data Files (数据集与生成数据)
# ------------------------------------------
data/
dataset/
datasets/
*.bin
*.npy
*.parquet
*.gz
*.tar.gz

# ------------------------------------------
# 2. Model Weights & Checkpoints (模型权重与训练产物)
# ------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
checkpoints/
models/
weights/
runs/
wandb/
*.log

# ------------------------------------------
# 3. Preserve Test Fixtures & Snapshots (保留测试固件与快照)
# ------------------------------------------
!**/tests/fixtures/**
!**/tests/_snapshots/**

# ------------------------------------------
# 4. Submission Archives (作业提交压缩包)
# ------------------------------------------
*.zip
*submission*.zip

# ------------------------------------------
# 5. Python & Environments (Python 缓存与虚拟环境)
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

.venv/
venv/
ENV/
env/
336_a2_test_venv/
.env

# ------------------------------------------
# 6. Testing & Code Quality (测试报告与缓存)
# ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
test_results.xml

# ------------------------------------------
# 7. IDE & Operating System (编辑器与系统文件)
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
